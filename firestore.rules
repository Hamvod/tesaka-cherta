rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function activeUser(uid) {
      return !exists(userPath(uid)) || get(userPath(uid)).data.status != 'suspended';
    }
    function admin() {
      return signedIn() && request.auth.token.admin == true && activeUser(request.auth.uid);
    }
    function verifiedOwner(uid) {
      return signedIn() && request.auth.uid == uid && request.auth.token.owner == true && activeUser(uid);
    }
    function ownActive(uid) { return signedIn() && request.auth.uid == uid && activeUser(uid); }
    function auctionPath(auctionId) { return /databases/$(database)/documents/auctions/$(auctionId); }
    function publicAuctionStatus(status) { return status in ['published', 'live', 'completed']; }

    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if admin() || (ownActive(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'city', 'language', 'marketingOptIn', 'role', 'status', 'ownerStatus', 'ownerApplicationStatus', 'createdAt', 'updatedAt', 'lastSignedIn']));
      allow update: if admin()
          ? request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'ownerStatus', 'ownerApplicationStatus', 'updatedAt', 'statusChangedBy', 'statusChangedAt'])
        : ownActive(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'phone', 'city', 'language', 'marketingOptIn', 'updatedAt', 'lastSignedIn'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSignedIn']) || request.resource.data.lastSignedIn == request.time);
      allow delete: if false;

      match /watchlist/{auctionId} {
        allow read: if admin() || (signedIn() && request.auth.uid == uid);
        allow create, update: if ownActive(uid)
          && request.resource.data.auctionId == auctionId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 220
          && request.resource.data.keys().hasOnly(['auctionId', 'title', 'imagePath', 'endsAt', 'createdAt']);
        allow delete: if ownActive(uid);
      }

      match /payments/{paymentId} {
        allow read: if admin() || (signedIn() && request.auth.uid == uid);
        allow create: if admin()
          || (ownActive(uid)
          && request.resource.data.uid == uid
          && request.resource.data.source == 'bidder_proof'
          && request.resource.data.status == 'pending'
          && request.resource.data.used == false
          && request.resource.data.amount is number
          && request.resource.data.auctionId is string
          && request.resource.data.createdAt == request.time);
        allow update: if admin()
          || (ownActive(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt', 'usedBidId'])
            && resource.data.status == 'paid' && resource.data.used == false && request.resource.data.used == true);
        allow delete: if false;

        match /proofs/{proofId} {
          allow read: if admin() || (ownActive(uid) && proofId == 'receipt');
          allow create: if ownActive(uid) && proofId == 'receipt' && request.resource.data.uid == uid && request.resource.data.paymentId == paymentId && request.resource.data.imageDataUrl is string && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }

      match /bids/{bidId} {
        allow read: if admin() || (signedIn() && request.auth.uid == uid);
        allow create: if ownActive(uid) && request.resource.data.auctionId is string && request.resource.data.amount is number && request.resource.data.createdAt == request.time;
        allow update: if ownActive(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isWinningBid', 'auctionStatus']);
        allow delete: if false;
      }

      match /wins/{auctionId} {
        allow read: if admin() || (signedIn() && request.auth.uid == uid);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if admin() || (signedIn() && request.auth.uid == uid);
        allow create: if admin() && request.resource.data.createdAt == request.time;
        allow update: if ownActive(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }

      match /devices/{deviceId} {
        allow read: if admin() || (signedIn() && request.auth.uid == uid);
        allow create: if ownActive(uid)
          && request.resource.data.keys().hasOnly(['label', 'userAgent', 'current', 'firstSeen', 'lastSeen'])
          && request.resource.data.label is string && request.resource.data.label.size() <= 80
          && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 500
          && request.resource.data.current is bool
          && request.resource.data.lastSeen == request.time
          && request.resource.data.firstSeen == request.time;
        allow update: if ownActive(uid)
          && request.resource.data.keys().hasOnly(['label', 'userAgent', 'current', 'firstSeen', 'lastSeen'])
          && request.resource.data.label is string && request.resource.data.label.size() <= 80
          && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 500
          && request.resource.data.current is bool
          && request.resource.data.lastSeen == request.time
          && request.resource.data.firstSeen == resource.data.firstSeen
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'userAgent', 'current', 'lastSeen']);
        allow delete: if ownActive(uid);
      }
    }

    match /ownerApplications/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if ownActive(uid) && request.resource.data.uid == uid && request.resource.data.status == 'pending' && request.resource.data.keys().hasOnly(['uid', 'businessName', 'city', 'contactPhone', 'description', 'status', 'submittedAt', 'updatedAt']);
      allow update: if admin() || (ownActive(uid) && resource.data.uid == uid && request.resource.data.uid == uid && request.resource.data.status == 'pending');
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid && activeUser(request.auth.uid)) || publicAuctionStatus(resource.data.status);
      allow create: if admin() || (signedIn() && request.resource.data.ownerUid == request.auth.uid && activeUser(request.auth.uid));
      allow update: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && activeUser(request.auth.uid));
      allow delete: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid && activeUser(request.auth.uid));
    }

    match /auctions/{auctionId} {
      allow read: if admin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid && activeUser(request.auth.uid))
        || publicAuctionStatus(resource.data.status);
      allow create: if admin() || (signedIn() && request.resource.data.ownerUid == request.auth.uid && activeUser(request.auth.uid));
      allow update: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && activeUser(request.auth.uid))
        || (signedIn() && activeUser(request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bidCount', 'updatedAt'])
          && request.resource.data.bidCount == resource.data.bidCount + 1 && request.resource.data.updatedAt == request.time);
      allow delete: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid && activeUser(request.auth.uid));

      match /entries/{bidId} {
        allow read: if admin() || (signedIn() && activeUser(request.auth.uid));
        allow create: if signedIn() && activeUser(request.auth.uid) && request.resource.data.uid == request.auth.uid
          && ((get(auctionPath(auctionId)).data.status == 'live')
            || (get(auctionPath(auctionId)).data.status == 'published'
              && get(auctionPath(auctionId)).data.startsAt <= request.time
              && get(auctionPath(auctionId)).data.endsAt > request.time));
        allow update, delete: if admin() || (signedIn() && request.resource.data.uid == request.auth.uid && activeUser(request.auth.uid));
      }
      match /bidderCounters/{uid} {
        allow read: if admin();
        allow create, update, delete: if false;
      }
      match /amountCounts/{amountCents} {
        allow read: if admin();
        allow create, update, delete: if false;
      }
    }

    match /auctionImages/{auctionId} {
      allow get: if admin() || (exists(auctionPath(auctionId))
        && (publicAuctionStatus(get(auctionPath(auctionId)).data.status)
          || (signedIn() && activeUser(request.auth.uid) && get(auctionPath(auctionId)).data.ownerUid == request.auth.uid)));
      allow list: if admin();
      allow create: if admin() || (signedIn() && request.resource.data.ownerUid == request.auth.uid && activeUser(request.auth.uid));
      allow update: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && activeUser(request.auth.uid));
      allow delete: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid && activeUser(request.auth.uid));
    }

    match /results/{auctionId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid && activeUser(request.auth.uid));
      allow create: if signedIn() && activeUser(request.auth.uid) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time;
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminReply', 'reviewedBy', 'reviewedAt', 'updatedAt']);
      allow delete: if false;
      match /private/{documentId} {
        allow read: if admin();
        allow create, update: if admin() && documentId == 'review';
        allow delete: if false;
      }
    }

    match /auditLogs/{eventId} {
      allow read: if admin();
      allow create, update, delete: if false;
    }

    match /paymentReferences/{referenceId} {
      allow read: if signedIn();
      allow create: if admin() || (signedIn() && activeUser(request.auth.uid) && request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time);
      allow update, delete: if false;
    }
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
